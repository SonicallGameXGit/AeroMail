# Copy to `.env` (never committed) and fill in. Read by `pnpm dev`, `pnpm build`
# and `pnpm test:app`; a variable set in the terminal wins over this file.

# Signing in with Google (AGENTS.md 5.3 and 6). From the Google Cloud console:
# an OAuth client of type "Desktop app" with the scope https://mail.google.com/.
# They are compiled into the core. Left empty, Gmail is set up with an app
# password instead.
MAILCLIENT_GOOGLE_CLIENT_ID=
MAILCLIENT_GOOGLE_CLIENT_SECRET=
